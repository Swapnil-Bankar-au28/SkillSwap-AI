# ── Required ──────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# ── Optional TTS Providers ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=optional_elevenlabs_key_here
OPENAI_API_KEY=optional_openai_key_here

# ── Optional Search Providers (duckduckgo works without a key) ────────────────
TAVILY_API_KEY=optional_tavily_key_here
SERPER_API_KEY=optional_serper_key_here
